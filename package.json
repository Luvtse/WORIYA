{
  "name": "woriya-express",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm -w @woriya-express/web run dev",
    "dev:api": "npm -w @woriya-express/api run dev",
    "build": "npm -w @woriya-express/api run build && npm -w @woriya-express/web run build",
    "lint": "npm -w @woriya-express/web run lint"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1"
  },
  "overrides": {
    "fast-xml-parser": "5.10.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "vitest": "^1.6.0"
  }
}
